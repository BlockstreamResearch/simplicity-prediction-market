mod unit_5 {
    pub fn not(bit: bool) -> bool {
    <u1>::into(jet::complement_1(<bool>::into(bit)))}
    pub fn or(a: bool, b: bool) -> bool {
    <u1>::into(jet::or_1(<bool>::into(a), <bool>::into(b)))}
    pub fn and(a: bool, b: bool) -> bool {
    <u1>::into(jet::and_1(<bool>::into(a), <bool>::into(b)))}
    pub fn xor(a: bool, b: bool) -> bool {
    and(or(a, b), not(and(a, b)))}
}
mod unit_4 {
    use crate::unit_5::and;
    pub fn and_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::and_64(a_high, b_high), jet::and_64(a_low, b_low)))}
    pub fn or_128(a: u128, b: u128) -> u128 {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        <(u64, u64)>::into((jet::or_64(a_high, b_high), jet::or_64(a_low, b_low)))}
    pub fn eq_128(a: u128, b: u128) -> bool {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        let (b_high, b_low): (u64, u64) = <u128>::into(b);
        and(jet::eq_64(a_high, b_high), jet::eq_64(a_low, b_low))}
    pub fn left_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((jet::left_shift_64(shift, a_low), 0))}
    ,
    true => {
    let (_, low_to_high_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::right_shift_64(low_to_high_amount, a_low);
        let res_high: u64 = jet::or_64(jet::left_shift_64(shift, a_high), shifted_bits);
        <(u64, u64)>::into((res_high, jet::left_shift_64(shift, a_low)))}
    ,
    }}
    ,
    true => a,
    }}
    pub fn right_shift_128(shift: u8, a: u128) -> u128 {
    match jet::is_zero_8(shift){
    false => {
    let (a_high, a_low): (u64, u64) = <u128>::into(a);
        match jet::lt_8(shift, 64){
    false => {
    let (_, shift): (bool, u8) = jet::subtract_8(shift, 64);
        <(u64, u64)>::into((0, jet::right_shift_64(shift, a_high)))}
    ,
    true => {
    let (_, high_to_low_amount): (bool, u8) = jet::subtract_8(64, shift);
        let shifted_bits: u64 = jet::left_shift_64(high_to_low_amount, a_high);
        let res_low: u64 = jet::or_64(jet::right_shift_64(shift, a_low), shifted_bits);
        <(u64, u64)>::into((jet::right_shift_64(shift, a_high), res_low))}
    ,
    }}
    ,
    true => a,
    }}
}
mod unit_1 {
    use crate::unit_4::eq_128;
    pub fn assert_eq_1(a: u1, b: u1) {
    assert!(jet::eq_1(a, b))}
    pub fn assert_eq_8(a: u8, b: u8) {
    assert!(jet::eq_8(a, b));
    }
    pub fn assert_eq_16(a: u16, b: u16) {
    assert!(jet::eq_16(a, b));
    }
    pub fn assert_eq_32(a: u32, b: u32) {
    assert!(jet::eq_32(a, b));
    }
    pub fn assert_eq_64(a: u64, b: u64) {
    assert!(jet::eq_64(a, b));
    }
    pub fn assert_eq_128(a: u128, b: u128) {
    assert!(eq_128(a, b));
    }
    pub fn assert_eq_256(a: u256, b: u256) {
    assert!(jet::eq_256(a, b));
    }
    pub fn assert_eq_bool(a: bool, b: bool) {
    assert_eq_1(<bool>::into(a), <bool>::into(b));
    }
    pub fn assert_none_1(val: Option<u1>) {
    assert!(is_none::<u1>(val));
    }
    pub fn assert_none_8(val: Option<u8>) {
    assert!(is_none::<u8>(val));
    }
    pub fn assert_none_16(val: Option<u16>) {
    assert!(is_none::<u16>(val));
    }
    pub fn assert_none_32(val: Option<u32>) {
    assert!(is_none::<u32>(val));
    }
    pub fn assert_none_64(val: Option<u64>) {
    assert!(is_none::<u64>(val));
    }
    pub fn assert_none_128(val: Option<u128>) {
    assert!(is_none::<u128>(val));
    }
    pub fn assert_none_256(val: Option<u256>) {
    assert!(is_none::<u256>(val));
    }
}
mod unit_2 {
    pub fn u64_to_u128(a: u64) -> u128 {
    <(u64, u64)>::into((0, a))}
    pub fn u64_to_u256(a: u64) -> u256 {
    let a_u128: u128 = u64_to_u128(a);
        <(u128, u128)>::into((0, a_u128))}
    pub fn split_u64_into_u8(a: u64) -> (u8, u8, u8, u8, u8, u8, u8, u8) {
    <u64>::into(a)}
    pub fn split_u64_into_u16(a: u64) -> (u16, u16, u16, u16) {
    <u64>::into(a)}
    pub fn split_u64_into_u32(a: u64) -> (u32, u32) {
    <u64>::into(a)}
    pub fn safe_u64_to_u1(a: u64) -> u1 {
    let u1_max: u64 = jet::left_pad_low_1_64(jet::high_1());
        assert!(jet::le_64(a, u1_max));
        jet::rightmost_64_1(a)}
    pub fn safe_u64_to_u8(a: u64) -> u8 {
    let u8_max: u64 = jet::left_pad_low_8_64(jet::high_8());
        assert!(jet::le_64(a, u8_max));
        jet::rightmost_64_8(a)}
    pub fn safe_u64_to_u16(a: u64) -> u16 {
    let u16_max: u64 = jet::left_pad_low_16_64(jet::high_16());
        assert!(jet::le_64(a, u16_max));
        jet::rightmost_64_16(a)}
    pub fn safe_u64_to_u32(a: u64) -> u32 {
    let u32_max: u64 = jet::left_pad_low_32_64(jet::high_32());
        assert!(jet::le_64(a, u32_max));
        jet::rightmost_64_32(a)}
}
mod unit_3 {
    use crate::unit_1::{assert_eq_64, assert_eq_256};
    pub fn get_explicit_input_amount(input_index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(input_index));
        let asset: u256 = unwrap_right::<Point>(asset);
        let amount: u64 = unwrap_right::<Point>(amount);
        (asset, amount)}
    pub fn assert_payout_preserves_position(output_index: u32) {
    let (output_asset, output_amount): (Asset1, Amount1) = unwrap(jet::output_amount(output_index));
        let output_asset: u256 = unwrap_right::<Point>(output_asset);
        let output_amount: u64 = unwrap_right::<Point>(output_amount);
        let (current_asset, current_amount): (Asset1, Amount1) = jet::current_amount();
        let current_asset: u256 = unwrap_right::<Point>(current_asset);
        let current_amount: u64 = unwrap_right::<Point>(current_amount);
        assert_eq_256(output_asset, current_asset);
        assert_eq_64(output_amount, current_amount);
    }
}
mod unit_0 {
    use crate::unit_1::assert_eq_256;
    use crate::unit_2::u64_to_u256;
    use crate::unit_3::{assert_payout_preserves_position, get_explicit_input_amount};
    fn resolution_hash(occurred_at: u64) -> u256 {
    let context: Ctx8 = jet::sha_256_ctx_8_init();
        let context: Ctx8 = jet::sha_256_ctx_8_add_32(context, param::PREDICTION_ID);
        let context: Ctx8 = jet::sha_256_ctx_8_add_32(context, u64_to_u256(occurred_at));
        jet::sha_256_ctx_8_finalize(context)}
    fn main() {
    let occurred_at: u64 = witness::OCCURRED_AT;
        let admin_signature: Signature = witness::ADMIN_SIGNATURE;
        let tick_input_index: u32 = witness::TICK_INPUT_INDEX;
        let payout_output_index: u32 = witness::PAYOUT_OUTPUT_INDEX;
        assert!(jet::le_64(occurred_at, param::DEADLINE));
        jet::bip_0340_verify((param::ADMIN_PUBKEY, resolution_hash(occurred_at)), admin_signature);
        let (tick_asset, tick_timestamp): (u256, u64) = get_explicit_input_amount(tick_input_index);
        assert_eq_256(tick_asset, param::TICK_ASSET_ID);
        assert_eq_256(unwrap(jet::input_script_hash(tick_input_index)), param::TICK_SCRIPT_HASH);
        assert!(jet::le_64(occurred_at, tick_timestamp));
        assert_eq_256(unwrap(jet::output_script_hash(payout_output_index)), param::PAYOUT_SCRIPT_HASH);
        assert_payout_preserves_position(payout_output_index);
    }
}
