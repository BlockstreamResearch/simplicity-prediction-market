}
mod unit_3 {
    use crate::unit_1::{assert_eq_64, assert_eq_256};
    use crate::unit_5::padding_96_tail;
    use crate::unit_6::get_p2tr_script_hash;
    use crate::unit_7::{get_explicit_input_amount, get_input_script_hash};
    pub type PriceFeedData = (u32, u64, u32, u64, u64);
    fn price_midstate() -> u256 {
    0x8af552810209fa371d86431baca6eba01583cc76358485deccea9f5dc6a63190}
    pub fn encode_price_feed_data(data: PriceFeedData) -> u256 {
    let (feed_id, price, decimals, received_at, valid_until): PriceFeedData = data;
        let ids: u64 = <(u32, u32)>::into((feed_id, decimals));
        let head: u128 = <(u64, u64)>::into((ids, price));
        let tail: u128 = <(u64, u64)>::into((received_at, valid_until));
        <(u128, u128)>::into((head, tail))}
    pub fn get_price_message(data: PriceFeedData) -> u256 {
    jet::sha_256_block(price_midstate(), encode_price_feed_data(data), padding_96_tail())}
    pub fn get_voucher_script_hash(internal_key: Pubkey, tapleaf_hash: u256) -> u256 {
    get_p2tr_script_hash(internal_key, tapleaf_hash)}
    pub fn verify_tick(tick_input_index: u32, tick_asset_id: u256) -> u64 {
    let (asset, amount): (u256, u64) = get_explicit_input_amount(tick_input_index);
        assert_eq_256(asset, tick_asset_id);
        amount}
    pub fn verify_verifier_utxo(verifier_input_index: u32, verifier_asset_id: u256, tapleaf_hash: u256, signer: Pubkey) {
    let (asset, amount): (u256, u64) = get_explicit_input_amount(verifier_input_index);
        assert_eq_256(asset, verifier_asset_id);
        assert_eq_64(amount, 1);
        assert_eq_256(get_input_script_hash(verifier_input_index), get_voucher_script_hash(signer, tapleaf_hash));
    }
    pub fn verify_price(verifier_input_index: u32, verifier_asset_id: u256, tapleaf_hash: u256, signer: Pubkey, signature: Signature, data: PriceFeedData, now: u64) -> PriceFeedData {
    verify_verifier_utxo(verifier_input_index, verifier_asset_id, tapleaf_hash, signer);
        jet::bip_0340_verify((signer, get_price_message(data)), signature);
        let (_, _, _, _, valid_until): PriceFeedData = data;
        assert!(jet::lt_64(now, valid_until));
        data}
    pub fn verify_tick_with_price(tick_input_index: u32, tick_asset_id: u256, verifier_input_index: u32, verifier_asset_id: u256, tapleaf_hash: u256, signer: Pubkey, signature: Signature, data: PriceFeedData) -> (u64, PriceFeedData) {
    let time: u64 = verify_tick(tick_input_index, tick_asset_id);
        let price: PriceFeedData = verify_price(verifier_input_index, verifier_asset_id, tapleaf_hash, signer, signature, data, time);
        (time, price)}
}
mod unit_0 {
    use crate::unit_1::assert_eq_256;
    use crate::unit_2::{assert_payout_preserves_position, get_explicit_input_amount};
    use crate::unit_3::{PriceFeedData, get_price_message, verify_verifier_utxo};
    fn main() {
    assert_eq_256(witness::PREDICTION_ID, param::PREDICTION_ID);
        let output_index: u32 = match witness::PATH{
    Left(claim: (u32, u256, Pubkey, Signature, PriceFeedData, u32)) => {
    let (verifier_index, tapleaf, signer, signature, data, payout_index): (u32, u256, Pubkey, Signature, PriceFeedData, u32) = claim;
        verify_verifier_utxo(verifier_index, param::VERIFIER_ASSET_ID, tapleaf, signer);
        jet::bip_0340_verify((signer, get_price_message(data)), signature);
        let (feed_id, price, decimals, received_at, _): PriceFeedData = data;
        assert!(jet::eq_32(feed_id, param::FEED_ID));
        assert!(jet::eq_32(decimals, param::DECIMALS));
        assert!(jet::le_64(param::OPENS_AT, received_at));
        assert!(jet::le_64(received_at, param::DEADLINE));
        assert!(match param::ABOVE{
    false => jet::le_64(price, param::STRIKE),
    true => jet::le_64(param::STRIKE, price),
    });
        assert_eq_256(unwrap(jet::output_script_hash(payout_index)), param::PAYOUT_SCRIPT_HASH);
        payout_index}
    ,
    Right(expiry: (u32, u32)) => {
    let (tick_index, house_index): (u32, u32) = expiry;
        let (asset, time): (u256, u64) = get_explicit_input_amount(tick_index);
        assert_eq_256(asset, param::TICK_ASSET_ID);
        let (carry, sweep_after): (bool, u64) = jet::add_64(param::DEADLINE, param::CLAIM_GRACE);
        assert!(match carry{
    false => true,
    true => false,
    });
        assert!(jet::lt_64(sweep_after, time));
        assert_eq_256(unwrap(jet::output_script_hash(house_index)), param::HOUSE_SCRIPT_HASH);
        house_index}
    ,
    };
        assert_payout_preserves_position(output_index);
    }
}
