use std::lib::asserts::{assert_eq_64, assert_eq_256};

pub fn get_explicit_input_amount(input_index: u32) -> (u256, u64) {
    let (asset, amount): (Asset1, Amount1) = unwrap(jet::input_amount(input_index));
    let asset: u256 = unwrap_right::<Point>(asset);
    let amount: u64 = unwrap_right::<Point>(amount);

    (asset, amount)
}

pub fn assert_payout_preserves_position(output_index: u32) {
    let (output_asset, output_amount): (Asset1, Amount1) = unwrap(jet::output_amount(output_index));
    let output_asset: u256 = unwrap_right::<Point>(output_asset);
    let output_amount: u64 = unwrap_right::<Point>(output_amount);
    let (current_asset, current_amount): (Asset1, Amount1) = jet::current_amount();
    let current_asset: u256 = unwrap_right::<Point>(current_asset);
    let current_amount: u64 = unwrap_right::<Point>(current_amount);

    assert_eq_256(output_asset, current_asset);
    assert_eq_64(output_amount, current_amount);
}